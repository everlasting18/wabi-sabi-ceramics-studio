# Supabase Configuration
# Get these values from https://supabase.com/dashboard > Project Settings > API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (safe to use in client-side code)
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Your Supabase project ID
VITE_SUPABASE_PROJECT_ID=your_project_id

# Cloudinary Configuration
# Get these values from https://cloudinary.com/console

# Your Cloudinary cloud name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Your Cloudinary upload preset (create one in Settings > Upload > Upload presets)
# Make sure to set it as "unsigned" for client-side uploads
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Your Cloudinary API key (optional, for advanced features)
VITE_CLOUDINARY_API_KEY=your_api_key
